# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=
# alerts.in.ua API token (request: alerts.in.ua/api-request). Limit ~10 requests/min per IP,
# shared with the desktop app on the same Mac, so keep INTERVAL_SECS >= 10.
ALERTS_IN_UA_TOKEN=
# Optional: only these chats may /start (your chat id is printed when you write to the bot)
ALLOWED_CHAT_IDS=
INTERVAL_SECS=60
